{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/v0.1/lineage.schema.json",
  "title": "Insight Sources",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "type", "description"],
        "properties": {
          "source_id": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
