{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/v0.1/versioning-review-history.schema.json",
  "title": "Insight Versioning Review History JSONL Record",
  "type": "object",
  "required": [
    "review_id",
    "review_type",
    "review_state",
    "target_type",
    "review_scope",
    "question_id",
    "claim_ids",
    "evidence_ids",
    "reviewer",
    "recorded_at",
    "source",
    "base_package_mutation",
    "generated",
    "current",
    "diffs"
  ],
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "review_type": { "const": "studio_question_review" },
    "review_state": {
      "type": "string",
      "enum": ["recorded", "exported", "superseded"]
    },
    "target_type": { "const": "prepared_question" },
    "review_scope": { "const": "question_target_only" },
    "package_id": { "type": "string" },
    "title": { "type": "string" },
    "domain_pack": { "type": "string" },
    "question_id": { "type": "string", "minLength": 1 },
    "section": { "type": "string" },
    "origin": { "type": "string" },
    "primary_claim_id": { "type": "string" },
    "primary_evidence_id": { "type": "string" },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewer": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "base_package_mutation": { "const": false },
    "generated": { "$ref": "#/$defs/snapshot" },
    "current": { "$ref": "#/$defs/snapshot" },
    "diffs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/diff" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["question", "status", "evidence", "review_note"],
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "status": { "type": "string" },
        "evidence": { "type": "string" },
        "review_note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "diff": {
      "type": "object",
      "required": ["field", "label", "before", "after"],
      "properties": {
        "field": {
          "type": "string",
          "enum": ["status", "question", "answer", "evidence", "review_note"]
        },
        "label": { "type": "string", "minLength": 1 },
        "before": { "type": "string" },
        "after": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
