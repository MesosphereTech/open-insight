{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/v0.1/evidence.schema.json",
  "title": "Insight Evidence JSONL Record",
  "type": "object",
  "required": ["evidence_id", "type", "summary", "source_refs"],
  "properties": {
    "evidence_id": { "type": "string" },
    "type": { "type": "string" },
    "summary": { "type": "string" },
    "query": { "type": "string" },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset_id"],
        "properties": {
          "dataset_id": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
