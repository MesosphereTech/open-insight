{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/v0.1/semantic.schema.json",
  "title": "Insight Metrics",
  "type": "object",
  "required": ["metrics"],
  "properties": {
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "name", "definition", "formula"],
        "properties": {
          "metric_id": { "type": "string" },
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "formula": { "type": "string" },
          "unit": { "type": "string" },
          "dataset_id": { "type": "string" },
          "source_column": { "type": "string" },
          "source_columns": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "origin": { "type": "string" },
          "blueprint_id": { "type": "string" },
          "matched_preferred_column": { "type": "string" },
          "field_role": {
            "type": "string",
            "enum": ["summary_value", "detail_value", "entity_id", "ratio_value", "numerator", "denominator"]
          },
          "source_field_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["summary_value", "detail_value", "entity_id", "ratio_value", "numerator", "denominator"]
            },
            "minItems": 1
          },
          "aggregation": {
            "type": "string",
            "enum": ["sum", "count", "latest_value", "ratio"]
          },
          "evidence_requirement": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
