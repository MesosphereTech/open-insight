{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/context-table-query-result.v0.1.schema.json",
  "title": "Open Insight CLI Context Table Query Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "profile",
    "package_id",
    "table_id",
    "operation",
    "row_count",
    "value",
    "source_refs",
    "lineage_refs",
    "parse_diagnostic_ids",
    "contract_refs"
  ],
  "properties": {
    "schema_version": { "const": "open-insight.context-table-query.v0.1" },
    "status": { "$ref": "#/$defs/status" },
    "profile": { "$ref": "#/$defs/profile" },
    "package_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "spec_version": { "type": "string" },
    "source_mode": { "$ref": "#/$defs/sourceMode" },
    "source_refs": { "$ref": "#/$defs/stringArray" },
    "lineage_refs": { "$ref": "#/$defs/stringArray" },
    "parse_diagnostic_ids": { "$ref": "#/$defs/stringArray" },
    "table_id": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["count", "sum", "average"] },
    "field": { "type": "string" },
    "filter": { "type": "string" },
    "row_count": { "type": "integer", "minimum": 0 },
    "value": { "type": "number" },
    "contract_refs": { "$ref": "#/$defs/stringArray" },
    "reason": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "status": { "enum": ["ok", "unsupported"] },
    "profile": { "enum": ["semantic_capsule", "v0_1_compat"] },
    "sourceMode": { "enum": ["source_bundled", "source_light", "unknown"] },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
