{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/schema-check-result.v0.1.schema.json",
  "title": "Open Insight CLI Schema Check Result",
  "type": "object",
  "required": ["schema_version", "status", "schema_root", "files", "issues"],
  "properties": {
    "schema_version": { "const": "open-insight.schema-check.v0.1" },
    "status": { "enum": ["ok", "invalid"] },
    "schema_root": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_file", "status"],
        "properties": {
          "schema_file": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "missing", "parse_error"] }
        },
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
