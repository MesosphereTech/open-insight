{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/validation-result.v0.1.schema.json",
  "title": "Open Insight CLI Validation Result",
  "type": "object",
  "required": ["schema_version", "status", "issues"],
  "properties": {
    "schema_version": { "const": "open-insight.validation-result.v0.1" },
    "status": { "enum": ["valid", "valid_with_warnings", "invalid"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
