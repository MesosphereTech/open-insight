{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/version-rollback-result.v0.1.schema.json",
  "title": "Open Insight CLI Version Rollback Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source_package_id",
    "source_title",
    "rollback_package_id",
    "rollback_title",
    "rollback_target",
    "reason",
    "output_file",
    "commit_id",
    "source_package_digest",
    "file_count",
    "version_paths",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": "open-insight.version-rollback.v0.1" },
    "status": { "const": "rollback_recorded" },
    "source_package_id": { "type": "string", "minLength": 1 },
    "source_title": { "type": "string", "minLength": 1 },
    "rollback_package_id": { "type": "string", "minLength": 1 },
    "rollback_title": { "type": "string", "minLength": 1 },
    "rollback_target": { "type": "string", "minLength": 1 },
    "reason": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "output_file": { "type": "string", "minLength": 1 },
    "commit_id": { "type": "string", "minLength": 1 },
    "source_package_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "file_count": { "type": "integer", "minimum": 1 },
    "version_paths": {
      "type": "object",
      "required": ["refs", "commits", "rollback_log"],
      "properties": {
        "parents": { "type": "string", "minLength": 1 },
        "refs": { "type": "string", "minLength": 1 },
        "commits": { "type": "string", "minLength": 1 },
        "rollback_log": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": ["base_package_mutation", "model_invoked", "package_code_execution"],
      "properties": {
        "base_package_mutation": { "const": false },
        "model_invoked": { "const": false },
        "package_code_execution": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
