{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/context-sources-result.v0.1.schema.json",
  "title": "Open Insight CLI Context Sources Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "profile",
    "package_id",
    "source_mode",
    "sources",
    "source_refs",
    "lineage_refs",
    "parse_diagnostic_ids"
  ],
  "properties": {
    "schema_version": { "const": "open-insight.context-sources.v0.1" },
    "status": { "$ref": "#/$defs/status" },
    "profile": { "$ref": "#/$defs/profile" },
    "package_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "spec_version": { "type": "string" },
    "source_mode": { "$ref": "#/$defs/sourceMode" },
    "source_refs": { "$ref": "#/$defs/stringArray" },
    "lineage_refs": { "$ref": "#/$defs/stringArray" },
    "parse_diagnostic_ids": { "$ref": "#/$defs/stringArray" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "type", "dataset_ids", "source_refs", "lineage_refs", "parse_diagnostic_ids"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "description": { "type": "string" },
          "dataset_ids": { "$ref": "#/$defs/stringArray" },
          "source_refs": { "$ref": "#/$defs/stringArray" },
          "lineage_refs": { "$ref": "#/$defs/stringArray" },
          "parse_diagnostic_ids": { "$ref": "#/$defs/stringArray" }
        },
        "additionalProperties": true
      }
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "status": { "enum": ["ok", "unsupported"] },
    "profile": { "enum": ["semantic_capsule", "v0_1_compat"] },
    "sourceMode": { "enum": ["source_bundled", "source_light", "unknown"] },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
