{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/context-output-recommendations-result.v0.1.schema.json",
  "title": "Open Insight Context Output Recommendations Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "profile",
    "package_id",
    "title",
    "spec_version",
    "source_mode",
    "source_refs",
    "lineage_refs",
    "parse_diagnostic_ids",
    "recommendation_basis",
    "recommendations",
    "proactive_user_message_cn",
    "output_boundary",
    "model_invoked",
    "base_package_mutation"
  ],
  "properties": {
    "schema_version": { "const": "open-insight.context-output-recommendations.v0.1" },
    "status": { "enum": ["ok", "unsupported"] },
    "profile": { "enum": ["semantic_capsule", "v0_1_compat"] },
    "package_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "spec_version": { "type": "string", "minLength": 1 },
    "source_mode": { "enum": ["source_bundled", "source_light", "unknown"] },
    "source_refs": { "$ref": "#/$defs/stringArray" },
    "lineage_refs": { "$ref": "#/$defs/stringArray" },
    "parse_diagnostic_ids": { "$ref": "#/$defs/stringArray" },
    "recommendation_basis": {
      "type": "object",
      "required": [
        "source_count",
        "source_types",
        "dataset_count",
        "field_count",
        "chunk_count",
        "parse_diagnostic_count",
        "parse_warning_count",
        "has_long_form_content",
        "has_structured_data",
        "multi_source"
      ],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "source_types": { "$ref": "#/$defs/stringArray" },
        "dataset_count": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "chunk_count": { "type": "integer", "minimum": 0 },
        "parse_diagnostic_count": { "type": "integer", "minimum": 0 },
        "parse_warning_count": { "type": "integer", "minimum": 0 },
        "has_long_form_content": { "type": "boolean" },
        "has_structured_data": { "type": "boolean" },
        "multi_source": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recommendation_id",
          "priority",
          "title",
          "title_cn",
          "content_suggestion",
          "content_suggestion_cn",
          "primary_format",
          "alternative_formats",
          "context_route",
          "readiness",
          "rationale",
          "rationale_cn",
          "next_action_cn"
        ],
        "properties": {
          "recommendation_id": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "title_cn": { "type": "string", "minLength": 1 },
          "content_suggestion": { "type": "string", "minLength": 1 },
          "content_suggestion_cn": { "type": "string", "minLength": 1 },
          "primary_format": { "$ref": "#/$defs/outputFormat" },
          "alternative_formats": { "type": "array", "items": { "$ref": "#/$defs/outputFormat" } },
          "context_route": { "enum": ["analysis", "html_restore", "word_outline", "ppt_outline", "question_answering", "audit_trace"] },
          "readiness": { "enum": ["ready", "needs_review", "limited"] },
          "rationale": { "$ref": "#/$defs/stringArray" },
          "rationale_cn": { "$ref": "#/$defs/stringArray" },
          "next_action_cn": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "proactive_user_message_cn": { "$ref": "#/$defs/stringArray" },
    "output_boundary": { "const": "external_file_or_overlay_or_derived_package" },
    "model_invoked": { "const": false },
    "base_package_mutation": { "const": false }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "outputFormat": { "enum": ["html", "word", "ppt", "qa", "audit"] }
  },
  "additionalProperties": true
}
