{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-insight.dev/schemas/cli/interop-check-result.v0.1.schema.json",
  "title": "Open Insight CLI Interop Check Result",
  "type": "object",
  "required": ["schema_version", "status", "summary_only", "schema", "conformance"],
  "properties": {
    "schema_version": { "const": "open-insight.interop-check.v0.1" },
    "status": { "enum": ["ok", "failed"] },
    "summary_only": { "type": "boolean" },
    "schema": {
      "type": "object",
      "required": ["schema_version", "status", "schema_root", "files", "issues"],
      "properties": {
        "schema_version": { "const": "open-insight.schema-check.v0.1" },
        "status": { "enum": ["ok", "invalid"] },
        "schema_root": { "type": "string" },
        "files": { "type": "array" },
        "issues": { "type": "array" }
      },
      "additionalProperties": true
    },
    "conformance": {
      "type": "object",
      "required": [
        "status",
        "total",
        "passed",
        "failed",
        "issue_code_assets",
        "issue_code_assets_passed",
        "issue_code_assets_failed",
        "assets"
      ],
      "properties": {
        "status": { "enum": ["ok", "failed", "skipped"] },
        "schema_version": { "const": "open-insight.conformance.v0.1" },
        "reason": { "type": "string" },
        "total": { "type": "number" },
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "issue_code_assets": { "type": "number" },
        "issue_code_assets_passed": { "type": "number" },
        "issue_code_assets_failed": { "type": "number" },
        "assets": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
